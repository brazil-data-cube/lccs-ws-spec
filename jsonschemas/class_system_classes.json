{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "class_system_classes.json#",
  "title": "Classification System Classes List",
  "type": "array",
  "definitions": {
    "link": {
      "type": "object",
      "required": ["rel", "href"],
      "properties": {
        "href": {
          "title": "Link reference",
          "type": "string"
        },
        "rel": {
          "title": "Link relation type",
          "type": "string"
        },
        "title": {
          "title": "Link title",
          "type": "string"
        }
      }
    }
  },
  "items": {
    "type": "object",
    "required": ["id", "name", "code", "links"],
    "properties": {
      "id": {
        "type": "integer"
      },
      "name": {
        "type": "string"
      },
      "code": {
        "type": "string"
      },
      "links": {
        "type": "array",
        "items": {
          "$ref": "#/definitions/link"
        }
      }
    }
  }
}
